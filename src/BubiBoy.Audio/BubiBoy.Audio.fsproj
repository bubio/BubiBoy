<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AudioHost.fs" />
    <Compile Include="Miniaudio.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BubiBoy.Core\BubiBoy.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\native\build\libbubi_miniaudio.dylib"
          Link="libbubi_miniaudio.dylib"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\..\native\build\libbubi_miniaudio.dylib') and ('$(RuntimeIdentifier)' == '' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-')))" />
    <None Include="..\..\native\build\libbubi_miniaudio.so"
          Link="libbubi_miniaudio.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\..\native\build\libbubi_miniaudio.so') and ('$(RuntimeIdentifier)' == '' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')))" />
    <None Include="..\..\native\build\bubi_miniaudio.dll"
          Link="bubi_miniaudio.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\..\native\build\bubi_miniaudio.dll') and ('$(RuntimeIdentifier)' == '' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')))" />
    <NativeLibrary Include="..\..\native\build\runtimes\**\*.*"
                   Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
                   CopyToPublishDirectory="PreserveNewest"
                   Pack="true"
                   PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
                   Condition="Exists('..\..\native\build\runtimes')" />
    <None Include="..\..\native\build\runtimes\**\*.*"
          Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never"
          Condition="Exists('..\..\native\build\runtimes')" />
  </ItemGroup>

</Project>
