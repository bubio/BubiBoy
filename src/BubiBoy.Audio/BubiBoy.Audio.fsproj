<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <BubiBoyBuildNativeMiniaudio Condition="'$(BubiBoyBuildNativeMiniaudio)' == ''">true</BubiBoyBuildNativeMiniaudio>
    <BubiBoyNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</BubiBoyNativeRid>
    <BubiBoyNativeRid Condition="'$(BubiBoyNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</BubiBoyNativeRid>
    <BubiBoyNativeLibraryName Condition="$([System.String]::Copy('$(BubiBoyNativeRid)').StartsWith('osx-'))">libbubi_miniaudio.dylib</BubiBoyNativeLibraryName>
    <BubiBoyNativeLibraryName Condition="$([System.String]::Copy('$(BubiBoyNativeRid)').StartsWith('linux-'))">libbubi_miniaudio.so</BubiBoyNativeLibraryName>
    <BubiBoyNativeLibraryName Condition="$([System.String]::Copy('$(BubiBoyNativeRid)').StartsWith('win-'))">bubi_miniaudio.dll</BubiBoyNativeLibraryName>
    <BubiBoyNativeRoot>$(MSBuildThisFileDirectory)../../native</BubiBoyNativeRoot>
    <BubiBoyNativeCMakeBuildDir>$(BubiBoyNativeRoot)/build/cmake/$(BubiBoyNativeRid)</BubiBoyNativeCMakeBuildDir>
    <BubiBoyNativeRuntimeDir>$(BubiBoyNativeRoot)/build/runtimes/$(BubiBoyNativeRid)/native</BubiBoyNativeRuntimeDir>
    <BubiBoyNativeRuntimeLibrary>$(BubiBoyNativeRuntimeDir)/$(BubiBoyNativeLibraryName)</BubiBoyNativeRuntimeLibrary>
    <BubiBoyNativeSources>$(BubiBoyNativeRoot)/CMakeLists.txt;$(BubiBoyNativeRoot)/bubi_miniaudio.c;$(BubiBoyNativeRoot)/miniaudio.h</BubiBoyNativeSources>
    <BubiBoyCanBuildNativeMiniaudio Condition="'$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == '$(NETCoreSdkRuntimeIdentifier)'">true</BubiBoyCanBuildNativeMiniaudio>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AudioHost.fs" />
    <Compile Include="Miniaudio.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BubiBoy.Core\BubiBoy.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <NativeLibrary Include="..\..\native\build\runtimes\**\*.*"
                   Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
                   CopyToPublishDirectory="PreserveNewest"
                   Pack="true"
                   PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
                   Condition="Exists('..\..\native\build\runtimes')" />
    <None Include="..\..\native\build\runtimes\**\*.*"
          Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never"
          Condition="Exists('..\..\native\build\runtimes')" />
    <!-- Place the native library flat next to the app. Self-contained single-file
         publish self-extracts native libraries flat at the bundle root, where .NET's
         built-in loader probes; a runtimes/<rid>/native nesting is never found there
         (NATIVE_DLL_SEARCH_DIRECTORIES is empty and BaseDirectory is the exe folder). -->
    <None Include="$(BubiBoyNativeRuntimeLibrary)"
          Link="$(BubiBoyNativeLibraryName)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="'$(BubiBoyBuildNativeMiniaudio)' == 'true' and '$(BubiBoyCanBuildNativeMiniaudio)' == 'true' and '$(BubiBoyNativeLibraryName)' != ''" />
  </ItemGroup>

  <Target Name="BuildBubiBoyNativeMiniaudio"
          BeforeTargets="PrepareForBuild"
          Inputs="$(BubiBoyNativeSources)"
          Outputs="$(BubiBoyNativeRuntimeLibrary)"
          Condition="'$(BubiBoyBuildNativeMiniaudio)' == 'true' and '$(BubiBoyCanBuildNativeMiniaudio)' == 'true' and '$(BubiBoyNativeLibraryName)' != ''">
    <MakeDir Directories="$(BubiBoyNativeRuntimeDir)" />
    <Exec Command="cmake -S &quot;$(BubiBoyNativeRoot)&quot; -B &quot;$(BubiBoyNativeCMakeBuildDir)&quot; -DCMAKE_BUILD_TYPE=$(Configuration)" />
    <Exec Command="cmake --build &quot;$(BubiBoyNativeCMakeBuildDir)&quot; --config $(Configuration)" />
    <Copy SourceFiles="$(BubiBoyNativeCMakeBuildDir)/$(BubiBoyNativeLibraryName)"
          DestinationFiles="$(BubiBoyNativeRuntimeLibrary)" />
  </Target>

</Project>
