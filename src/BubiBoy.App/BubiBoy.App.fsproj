<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BubiBoy</AssemblyName>
    <Product>BubiBoy</Product>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AboutWindow.fs" />
    <Compile Include="PerfTrace.fs" />
    <Compile Include="DisplayHelpers.fs" />
    <Compile Include="InputMapping.fs" />
    <Compile Include="RomSession.fs" />
    <Compile Include="MainWindowViewModel.fs" />
    <Compile Include="MainWindow.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BubiBoy.Core\BubiBoy.Core.fsproj" />
    <ProjectReference Include="..\BubiBoy.IO\BubiBoy.IO.fsproj" />
    <ProjectReference Include="..\BubiBoy.Audio\BubiBoy.Audio.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
  </ItemGroup>

</Project>
