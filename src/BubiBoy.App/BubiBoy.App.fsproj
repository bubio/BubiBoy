<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-arm64;linux-x64;win-arm64;win-x64</RuntimeIdentifiers>
    <AssemblyName>BubiBoy</AssemblyName>
    <Product>BubiBoy</Product>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) or ('$(RuntimeIdentifier)' == 'win-x64' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <UseMacOSBundle Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-')))">true</UseMacOSBundle>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseMacOSBundle)' == 'true'">
    <MacOSBundleOutputSegment Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</MacOSBundleOutputSegment>
    <MacOSBundleOutputSegment Condition="'$(MacOSBundleOutputSegment)' == ''">$(Platform)</MacOSBundleOutputSegment>
    <OutputPath>bin\$(Configuration)\$(MacOSBundleOutputSegment)\BubiBoy.app\Contents\MacOS\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishDir Condition="'$(RuntimeIdentifier)' != ''">$(OutputPath)</PublishDir>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AppFonts.fs" />
    <Compile Include="AppTheme.fs" />
    <Compile Include="AboutWindow.fs" />
    <Compile Include="PerfTrace.fs" />
    <Compile Include="DisplayHelpers.fs" />
    <Compile Include="VideoDisplay.fs" />
    <Compile Include="GameViewport.fs" />
    <Compile Include="RuntimeCounters.fs" />
    <Compile Include="InputMapping.fs" />
    <Compile Include="ControllerInputAdapter.fs" />
    <Compile Include="InputStateController.fs" />
    <Compile Include="EmulationRunner.fs" />
    <Compile Include="DialogLayout.fs" />
    <Compile Include="InputMappingWindow.fs" />
    <Compile Include="SettingsWindow.fs" />
    <Compile Include="RomSession.fs" />
    <Compile Include="RomWorkflow.fs" />
    <Compile Include="AppSettingsStore.fs" />
    <Compile Include="MainWindowViewModel.fs" />
    <Compile Include="VolumeControl.fs" />
    <Compile Include="AppChrome.fs" />
    <Compile Include="AppDialogs.fs" />
    <Compile Include="AppNotificationCenter.fs" />
    <Compile Include="OutputVolumeController.fs" />
    <Compile Include="AppInputHost.fs" />
    <Compile Include="WindowLayoutController.fs" />
    <Compile Include="MainWindowMenus.fs" />
    <Compile Include="FrameDisplayTimer.fs" />
    <Compile Include="EmulationSessionController.fs" />
    <Compile Include="MainWindow.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BubiBoy.Core\BubiBoy.Core.fsproj" />
    <ProjectReference Include="..\BubiBoy.IO\BubiBoy.IO.fsproj" />
    <ProjectReference Include="..\BubiBoy.Audio\BubiBoy.Audio.fsproj" />
    <ProjectReference Include="..\ControllerInput\ControllerInput.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\AppIcon.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseMacOSBundle)' == 'true'">
    <MacOSBundleInfoPlist Include="Platforms\macOS\Info.plist" />
    <MacOSBundleIcon Include="Assets\AppIcon.icns" />
  </ItemGroup>

  <PropertyGroup Condition="'$(UseMacOSBundle)' == 'true'">
    <MacOSBundleContentsDir Condition="'$(PublishDir)' != ''">$(PublishDir)..\</MacOSBundleContentsDir>
    <MacOSBundleContentsDir Condition="'$(PublishDir)' == ''">$(OutputPath)..\</MacOSBundleContentsDir>
  </PropertyGroup>

  <Target Name="CopyMacOSBundleInfoPlist" AfterTargets="Build;Publish" Condition="'$(UseMacOSBundle)' == 'true'">
    <MakeDir Directories="$(MacOSBundleContentsDir)" />
    <Copy SourceFiles="@(MacOSBundleInfoPlist)" DestinationFolder="$(MacOSBundleContentsDir)" />
  </Target>

  <Target Name="CopyMacOSBundleIcon" AfterTargets="Build;Publish" Condition="'$(UseMacOSBundle)' == 'true'">
    <PropertyGroup>
      <MacOSBundleResourcesDir>$(MacOSBundleContentsDir)Resources\</MacOSBundleResourcesDir>
    </PropertyGroup>
    <MakeDir Directories="$(MacOSBundleResourcesDir)" />
    <Copy SourceFiles="@(MacOSBundleIcon)" DestinationFolder="$(MacOSBundleResourcesDir)" />
  </Target>

  <Target Name="AdHocSignMacOSBundle" AfterTargets="Publish" Condition="'$(UseMacOSBundle)' == 'true' and '$(PublishDir)' != ''">
    <PropertyGroup>
      <MacOSBundleAppDir>$([System.IO.Path]::GetFullPath('$(PublishDir)..\..'))</MacOSBundleAppDir>
    </PropertyGroup>
    <Exec Command="codesign --force --deep --sign - &quot;$(MacOSBundleAppDir)&quot;" />
  </Target>

</Project>
